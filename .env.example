# =============================================================================
# BDB CMS — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit your actual .env file to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# APP
# -----------------------------------------------------------------------------
APP_NAME=BDB

# Change to "production" on the live server.
APP_ENV=local

APP_KEY=

# Must be false in production — exposes sensitive error details if true.
APP_DEBUG=true

# Update to your live domain before deploying.
APP_URL=https://bdb.uz

APP_LOCALE=uz
APP_FALLBACK_LOCALE=ru
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# -----------------------------------------------------------------------------
# ADMIN ACCOUNT (used by `php artisan db:seed`)
# Use a strong password. The admin is not seeded if ADMIN_PASSWORD is empty.
# -----------------------------------------------------------------------------
ADMIN_NAME="BDB Admin"
ADMIN_EMAIL=admin@bdb.uz
ADMIN_PASSWORD=

# -----------------------------------------------------------------------------
# LOGGING
# -----------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null

# Use "debug" in local, "error" or "warning" in production.
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# DATABASE
# Default: SQLite (dev only). For production use MySQL or PostgreSQL below.
# -----------------------------------------------------------------------------
DB_CONNECTION=sqlite
# DB_DATABASE=/absolute/path/to/database.sqlite

# MySQL (uncomment and fill in for production):
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=bdb
# DB_USERNAME=bdb_user
# DB_PASSWORD=

# PostgreSQL (alternative):
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=bdb
# DB_USERNAME=bdb_user
# DB_PASSWORD=

# -----------------------------------------------------------------------------
# CACHE / QUEUE / SESSION
# -----------------------------------------------------------------------------
CACHE_STORE=database

QUEUE_CONNECTION=database

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# -----------------------------------------------------------------------------
# MAIL
# Set MAIL_MAILER=smtp and fill in credentials for transactional email.
# -----------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@bdb.uz"
MAIL_FROM_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# ANALYTICS
# Paste your Google Analytics / Yandex.Metrika script tags in Admin →
# Company Info → Analytics Scripts. No env var needed.
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# VITE (frontend build)
# -----------------------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"

# AI CHAT ASSISTANT (Google Gemini — free key at https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# CHAT LEAD ALERTS (Telegram) — create a bot with @BotFather, add it to your
# sales group, then put the bot token and the group's chat ID here.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Lets customers chat with the AI assistant in the same bot. Any random string
# (16+ chars: letters, digits, _ or -), then run: php artisan telegram:webhook set
TELEGRAM_WEBHOOK_SECRET=
